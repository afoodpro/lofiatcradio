[Unit]
Description=ATC Live Radio radar proxy (adsb.lol + OpenSky)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
ExecStart=/usr/bin/python3 /opt/lofiatc-radar/radar_proxy.py
Environment=STATIONS_PATH=/opt/lofiatc-radar/stations.json
LoadCredential=opensky.json:/etc/lofiatc/opensky.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
