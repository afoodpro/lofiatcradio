[Unit]
Description=ATC Live Radio radar proxy (adsb.lol + OpenSky)
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
ExecStart=/usr/bin/python3 /opt/lofiatc-radar/radar_proxy.py
Environment=STATIONS_PATH=/opt/lofiatc-radar/stations.json
Environment=OPENSKY_CREDS=%d/opensky.json
LoadCredential=opensky.json:/etc/lofiatc/opensky.json
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
